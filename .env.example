# Vercel server-only environment. Never commit real values.
OGZ_BACKEND_ORIGIN=https://your-backend.chatgpt.site
OGZ_BACKEND_TOKEN=
OGZ_DEPLOYMENT_KEY=
ADMIN_USERNAME=
# salt:scrypt-hash; never store the plaintext password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Worker server-only Supabase game state configuration (hosting dashboard).
# Keep OGZ_SUPABASE_KEY secret; never send it to the browser.
OGZ_GAME_DB=supabase
OGZ_SUPABASE_URL=https://your-project.supabase.co/functions/v1/ogz-game-listings
OGZ_SUPABASE_KEY=
